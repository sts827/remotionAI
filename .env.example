# Text Generation (Script)
# Options: 'gemini' | 'claude' | 'mock'
TEXT_PROVIDER=gemini 
GEMINI_API_KEY=your_google_key
# Text Model (User Preference: gemini-2.5-flash)
GEMINI_TEXT_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=your_anthropic_key

# Image Generation
# Options: 'gemini' | 'mock'
IMAGE_PROVIDER=gemini
IMAGEN_API_KEY=your_google_key
# Image Model (User Preference: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# TTS (Voice)
# Options: 'gemini' | 'elevenlabs' | 'mock'
TTS_PROVIDER=gemini
# ELEVENLABS_API_KEY=your_elevenlabs_key
# TTS Model (User Preference: gemini-2.5-flash-preview-tts)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# ELEVENLABS_VOICE_ID=your_voice_id_here

# Configuration
TEXT_PROVIDER=gemini  # gemini, openai, mock
#TTS_PROVIDER=mock     # elevenlabs, openai, mock
